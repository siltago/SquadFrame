<Window x:Class="SquadEngineer.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SquadEngineer.Desktop" Title="SquadEngineer" Height="760" Width="1180" MinHeight="620" MinWidth="940" Background="#F4F6F8" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#1F2937" /></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#6B7280"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <HierarchicalDataTemplate DataType="{x:Type local:FileTreeNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="2,4"><TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}"/><TextBlock Text="{Binding Details}" Foreground="#6B7280" Margin="12,0,0,0"/></StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><StackPanel><TextBlock Text="SquadEngineer" FontSize="30" FontWeight="Bold" Foreground="#166534"/><TextBlock Text="Arquivos de engenharia e revisões locais" Foreground="#6B7280" FontSize="14"/></StackPanel><Border DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="● Agent não iniciado" Foreground="#92400E" FontWeight="SemiBold"/></Border></DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource Label}" Text="ARQUIVO ATUAL"/><TextBlock Text="{Binding CurrentFile}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="REVISÃO ATUAL"/><TextBlock Text="{Binding CurrentRevision}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="ÚLTIMA VERSÃO"/><TextBlock Text="{Binding LatestVersion}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Label}" Text="ARMAZENAMENTO"/><TextBlock Text="Servidor local" FontSize="16" FontWeight="SemiBold" Foreground="#166534"/></StackPanel>
    </Grid></Border>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
      <TabControl BorderThickness="0">
        <TabItem Header="Arquivos do servidor">
          <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel><StackPanel><TextBlock Text="Pasta de engenharia" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding ServerRoot}" Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar pasta" Click="SelectServerFolder_Click"/><Button Content="Atualizar" Click="RefreshServerFiles_Click"/></StackPanel></DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding ServerStatus}" Foreground="{Binding ServerStatusColor}" Margin="0,14,0,10"/>
            <TreeView Grid.Row="2" ItemsSource="{Binding ServerTree}" SelectedItemChanged="ServerTree_SelectedItemChanged" MouseDoubleClick="ServerTree_DoubleClick" BorderThickness="0" Padding="4"/>
            <TextBlock Grid.Row="3" Text="Expanda as pastas para navegar. Clique duas vezes em um arquivo para abri-lo no aplicativo padrão." Foreground="#6B7280" Margin="0,10,0,0"/>
          </Grid>
        </TabItem>
        <TabItem Header="Revisões locais">
          <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><TextBlock Text="Revisões locais" FontSize="20" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="{Binding VersionRoot}" Foreground="#6B7280"/></DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Versions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"><DataGrid.Columns><DataGridTextColumn Header="Arquivo" Binding="{Binding ProjectFile.Name}" Width="2*"/><DataGridTextColumn Header="Revisão" Binding="{Binding RevisionLabel}" Width="*"/><DataGridTextColumn Header="Criada em" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.5*"/><DataGridTextColumn Header="Usuário" Binding="{Binding Metadata.WindowsUser}" Width="*"/><DataGridTextColumn Header="Computador" Binding="{Binding Metadata.Computer}" Width="*"/></DataGrid.Columns></DataGrid>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</Window>
